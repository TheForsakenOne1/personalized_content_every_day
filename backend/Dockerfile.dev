# Development Dockerfile for Backend
# Used for docker-compose.dev.yml with hot reload

FROM node:18-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache libc6-compat openssl

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including dev)
RUN npm install && \
    npx prisma generate

# Copy source code
COPY . .

# Expose port
EXPOSE 4000

# Start in development mode with hot reload
CMD ["npm", "run", "dev"]
