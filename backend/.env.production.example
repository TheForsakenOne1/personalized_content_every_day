# Server Configuration
NODE_ENV=production
PORT=4000
API_VERSION=v1

# Database Configuration - PostgreSQL (Railway/Render will auto-set this)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Redis Configuration (Optional - Upstash or Railway Redis)
REDIS_URL=redis://default:password@host:6379
REDIS_PASSWORD=

# JWT Configuration - CRITICAL: Use secure secrets in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# External APIs (Optional - for content aggregation)
YOUTUBE_API_KEY=
OPENAI_API_KEY=

# Research Paper Sources (Optional - for academic content)
IEEE_API_KEY=
SPRINGER_API_KEY=
SERP_API_KEY=

# n8n Integration (Optional - for workflow automation)
N8N_WEBHOOK_SECRET=
N8N_API_URL=

# Email Configuration (Required for password reset)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# CORS - CRITICAL: Set to your frontend URL
CORS_ORIGIN=https://your-frontend.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# App URL - Your frontend URL
APP_URL=https://your-frontend.vercel.app
