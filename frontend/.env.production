# API Configuration
NEXT_PUBLIC_API_URL=https://personalized-content-every-day.onrender.com
NEXT_PUBLIC_WS_URL=wss://personalized-content-every-day.onrender.com

# NextAuth Configuration
NEXTAUTH_URL=https://personalized-content-every-day-fron.vercel.app
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_IN_PRODUCTION

# Environment
NEXT_PUBLIC_ENV=production

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEV_MODE=false

# Monitoring & Analytics
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_GA_TRACKING_ID=your-google-analytics-id
