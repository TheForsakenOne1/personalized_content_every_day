            },
            {
              "name": "title",
              "value": "={{$json[\"title\"]}}"
            },
            {
              "name": "description",
              "value": "={{$json[\"description\"]}}"
            },
            {
              "name": "url",
              "value": "={{$json[\"url\"]}}"
            },
            {
              "name": "thumbnail_url",
              "value": "={{$json[\"thumbnail_url\"]}}"
            },
            {
              "name": "author",
              "value": "={{$json[\"author\"]}}"
            },
            {
              "name": "published_at",
              "value": "={{$json[\"published_at\"]}}"
            },
            {
              "name": "duration",
              "value": "={{$json[\"duration\"]}}"
            },
            {
              "name": "quality_score",
              "value": "={{$json[\"quality_score\"]}}"
            },
            {
              "name": "popularity_score",
              "value": "={{$json[\"popularity_score\"]}}"
            },
            {
              "name": "metadata",
              "value": "={{$json[\"metadata\"]}}"
            }
          ]
        }
      },
      "name": "Insert to Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1790, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "Backend API Auth"
        }
      }
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "result",
              "value": "={{$json[\"success\"] ? 'Added: ' + $json[\"data\"][\"content\"][\"title\"] : 'Failed'}}"
            }
          ]
        }
      },
      "name": "Format Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [2010, 200]
    }
  ],
